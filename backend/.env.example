# Copy this file to backend/.env and adjust as needed.
# All paths are resolved relative to the project root by default.
# Only override if your data is in a non-standard location.

# Uncomment and set to override defaults:
# PRODUCTS_CSV=/path/to/products_ml_ready.csv
# TEXT_FAISS=/path/to/text_index.faiss
# IMAGE_FAISS=/path/to/image_index.faiss
# TEXT_MAPPING=/path/to/text_index_mapping.csv
# IMAGE_MAPPING=/path/to/image_index_mapping.csv
# IMAGES_DIR=/path/to/data/images
# UPLOAD_DIR=/path/to/backend/uploads

# Model names (HuggingFace IDs)
CLIP_MODEL=openai/clip-vit-base-patch32
QWEN_LLM_MODEL=Qwen/Qwen2.5-3B-Instruct
QWEN_VL_MODEL=Qwen/Qwen2-VL-2B-Instruct

# Search defaults
DEFAULT_TOP_K=10
MAX_TOP_K=50
DEFAULT_RETRIEVAL_K=50
DEFAULT_TEXT_WEIGHT=0.5
DEFAULT_IMAGE_WEIGHT=0.5

# Upload limits
MAX_UPLOAD_BYTES=10485760
# ALLOWED_IMAGE_TYPES=["image/jpeg","image/png","image/webp"]

# Server
HOST=0.0.0.0
PORT=8000
RELOAD=false
